# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:8080

# Banco de dados (SQLite, arquivo local)
DATABASE_PATH=data/app.db

# Diretório onde o repo de dados oficial (CIT-SME-RJ/dadoscreche) foi clonado
# — usado só pelos scripts de seed (src/seed/*), não em runtime normal.
DADOSCRECHE_DIR=../data/dadoscreche

# Login admin (único, genérico — sem papéis/hierarquia por enquanto)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# E-mail (Hostinger SMTP) — envio do código de verificação (2FA) do portal da mãe.
# Se deixar em branco, o backend cai em modo "dev": loga o código no console
# em vez de enviar e-mail de verdade (útil pra testar sem credencial configurada).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@keyva.com.br
SMTP_PASS=

# IA (Claude API) — usado em POST /api/ia/recomendar-unidades. Sem isso, o
# endpoint funciona normalmente caindo no fallback determinístico.
ANTHROPIC_API_KEY=

# Modelo e teto de tempo do agente de recomendação. Com as 7 tools o loop mede 25-40s;
# ao estourar o timeout, o endpoint responde com o fallback determinístico (fonte:
# "fallback"). Se mexer aqui, ajuste também o timeout do axios no frontend
# (vite-ts/src/lib/creche-api.ts, recomendarUnidadesIA), que precisa ficar acima deste.
IA_MODELO=claude-haiku-4-5
IA_TIMEOUT_MS=40000

# Portal da Transparência (api.portaldatransparencia.gov.br) — API pública
# federal (CGU), usada pra consultar Bolsa Família por NIS. Sem CadÚnico
# (essa base não tem API pública, só convênio direto com MDS/Caixa).
# Pegar a chave gratuita em https://api.portaldatransparencia.gov.br/
TRANSPARENCIA_API_KEY=
