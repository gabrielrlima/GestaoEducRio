# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:8080

# Banco de dados (SQLite, arquivo local)
DATABASE_PATH=data/app.db

# Diretório onde o repo de dados oficial (CIT-SME-RJ/dadoscreche) foi clonado
# — usado só pelos scripts de seed (src/seed/*), não em runtime normal.
DADOSCRECHE_DIR=../data/dadoscreche

# Login admin (único, genérico — sem papéis/hierarquia por enquanto)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# E-mail (Hostinger SMTP) — envio do código de verificação (2FA) do portal da mãe.
# Se deixar em branco, o backend cai em modo "dev": loga o código no console
# em vez de enviar e-mail de verdade (útil pra testar sem credencial configurada).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@keyva.com.br
SMTP_PASS=

# IA (Claude API) — usado em POST /api/ia/recomendar-unidades. Sem isso, o
# endpoint funciona normalmente caindo no fallback determinístico.
ANTHROPIC_API_KEY=
